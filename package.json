{
  "name": "@http-forge/codegen",
  "version": "0.1.2",
  "description": "HTTP Forge Code Generator - Generate typed API clients from collections",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "http-forge-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && node esbuild.config.js",
    "build:prod": "npm run clean && node esbuild.config.js --production",
    "prepublishOnly": "npm run build:prod",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "keywords": [
    "http",
    "api",
    "codegen",
    "typescript",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.12",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
